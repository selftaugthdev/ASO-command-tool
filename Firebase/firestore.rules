rules_version = '2';

// The relay collection is written only by the Cloud Function (which uses the
// Admin SDK and bypasses these rules) and read only by the macOS app via a
// service account (which also bypasses them).
//
// So every rule here denies: no client SDK, signed in or not, should ever touch
// revenue data directly. Locking this down matters because the collection holds
// purchase history keyed to app user ids.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
